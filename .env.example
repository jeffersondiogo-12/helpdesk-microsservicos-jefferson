# Nada aqui é obrigatório: `docker compose up --build` funciona sem .env.
# Para mudar algo, copie este arquivo para .env. O .env nunca deve ir para o GitHub.

# Segredo que ASSINA (serviço de Usuários) e CONFERE (todos os serviços) os tokens de login.
# Precisa ser o mesmo em todos os serviços; o Compose repassa este valor a todos eles.
# Mínimo de 32 caracteres. Gere um com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Se ficar vazio, o Compose gera um segredo aleatório na primeira subida e guarda num volume.
JWT_SEGREDO=

# Tempo de validade do login, em minutos
TOKEN_MINUTOS=60

# 1 = cria usuários, equipamentos e chamados de exemplo (só para aula)
DADOS_EXEMPLO=1
# Senha dos usuários de exemplo
SENHA_EXEMPLO=Helpdesk2026

# Tempo máximo (segundos) que o serviço de Chamados espera por Usuários ou Inventário
TIMEOUT_SEGUNDOS=3

# 1 = liga a documentação /docs dentro de cada serviço (fica atrás do gateway: use só rodando um serviço sozinho)
DOCS=0
